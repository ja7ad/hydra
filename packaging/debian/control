# Not "hydra": that binary package already exists in universe (THC-Hydra, the
# login cracker, built from the thc-hydra source) at version 9.x, so a PPA
# package of the same name loses every version comparison and
# `apt install hydra` silently installs the cracker instead. The conflict is
# over /usr/bin/hydra, which both ship.
Package: hydra-download-manager
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}, libgtk-3-0 | libgtk-3-0t64
Conflicts: hydra
Suggests: gnome-shell-extension-appindicator
Description: Multi-connection download manager (GUI, CLI, browser integration)
 Hydra downloads files over many parallel connections with integrity
 verification. This package installs the hydra CLI, the hydra-gui desktop
 app (with menu entry and login autostart), the hydra-host native-messaging
 bridge, and browser extension assets.
