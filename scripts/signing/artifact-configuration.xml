<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" min-matches="1" max-matches="unbounded" />
      <include path="**/*torrent*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <powershell-file-set>
      <include path="**/install.ps1" min-matches="0" max-matches="unbounded" />
      <include path="**/install-native-host.ps1" min-matches="0" max-matches="unbounded" />
      <include path="**/uninstall.ps1" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </powershell-file-set>
  </zip-file>
</artifact-configuration>
